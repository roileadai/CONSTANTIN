# Скопируй в .env и заполни — не коммить .env!
# Генерация ключей: openssl rand -hex 32

# === Postgres ===
POSTGRES_USER=constantin
POSTGRES_PASSWORD=CHANGE_ME_32_CHARS
POSTGRES_DB=constantin
TZ=Europe/Almaty

# === n8n (оркестрация) ===
N8N_ENCRYPTION_KEY=CHANGE_ME_32_CHARS_MIN
N8N_USER=admin
N8N_PASSWORD=CHANGE_ME_STRONG

# === Telegram ===
BOT_TOKEN=123456:AAH-GET_FROM_BOTFATHER
BOT_WEBHOOK_URL=https://constantin.sh/webhook/telegram

# === LLM (выбери 1) ===
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Для локального Ollama (без API-платежей): OLLAMA_HOST=http://ollama:11434

# === OpenClaw / Hermes ===
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5

# === SaaS (если делаешь SaaS, не только бота) ===
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXTAUTH_URL=https://constantin.sh
NEXTAUTH_SECRET=CHANGE_ME_32

# === Stars (Telegram) ===
# Stars не требуют API-ключа — платежи приходят webhook'ом от Telegram.
# Вывод через Fragment: https://fragment.com/stars/withdraw
